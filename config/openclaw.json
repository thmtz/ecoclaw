{
  "models": {
    "providers": {
      "vllm": {
        "baseUrl": "http://127.0.0.1:8001/v1",
        "apiKey": "none",
        "api": "openai-completions",
        "models": [
          {
            "id": "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8",
            "name": "Nemotron Nano 30B (FP8)"
          },
          {
            "id": "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4",
            "name": "Nemotron Super 120B (NVFP4)"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "vllm/nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8"
      },
      "workspace": "~/.openclaw/workspace",
      "memorySearch": {
        "enabled": false
      }
    }
  },
  "gateway": {
    "mode": "local",
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  }
}
