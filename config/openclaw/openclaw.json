{
  "models": {
    "providers": {
      "vllm": {
        "baseUrl": "http://127.0.0.1:8001/v1",
        "apiKey": "none",
        "api": "openai-completions",
        "models": [
          {
            "id": "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8",
            "name": "Nemotron Nano 30B FP8"
          },
          {
            "id": "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4",
            "name": "Nemotron Super 120B"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "vllm/nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8"
      },
      "memorySearch": {
        "enabled": false
      }
    }
  },
  "commands": {
    "native": false,
    "nativeSkills": false,
    "restart": true,
    "ownerDisplay": "raw"
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "YOUR_TOKEN_HERE"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    },
    "controlUi": {
      "allowedOrigins": [
        "http://10.1.96.152:18789",
        "http://localhost:18789"
      ],
      "dangerouslyAllowHostHeaderOriginFallback": true
    }
  }
}
