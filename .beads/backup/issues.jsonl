{"acceptance_criteria":"","actor":"","agent_state":"","assignee":null,"await_id":"","await_type":"","close_reason":"Same fix as pxn.1 — per-IP cooldown commit 61348bf.","closed_at":"2026-03-17T22:32:43Z","closed_by_session":"","compacted_at":null,"compacted_at_commit":null,"compaction_level":0,"content_hash":"60b1508613c0cd5ed0bbdaeb5cb91c5f6d6aa9586d1b8b81aa1337967891b1d2","created_at":"2026-03-17T22:24:24Z","created_by":"Joey Thometz","crystallizes":0,"defer_until":null,"description":"OpenClaw makes 2 requests per user message (agent loop). Both get receipts. Fix: track last receipt injection time per client IP. If same IP makes another chat request within 10s, skip receipt on that one. Use a module-level dict: _last_receipt: dict[str, float] = {}. In _stream_proxy(), get client_ip from request, check time.time() - _last_receipt.get(ip, 0) \u003c 10 to suppress. Update _last_receipt[ip] = time.time() when injecting. Thread-safe with asyncio (single-threaded event loop).","design":"","due_at":null,"ephemeral":0,"estimated_minutes":null,"event_kind":"","external_ref":null,"hook_bead":"","id":"hackathon-pxn.4","is_template":0,"issue_type":"bug","last_activity":null,"metadata":"{}","mol_type":"","no_history":0,"notes":"","original_size":null,"owner":"joey@neuralwatt.com","payload":"","pinned":0,"priority":1,"quality_score":null,"rig":"","role_bead":"","role_type":"","sender":"","source_repo":"","source_system":"","spec_id":"","status":"closed","target":"","timeout_ns":0,"title":"Fix double receipt: add per-IP cooldown to skip rapid repeat injections","updated_at":"2026-03-17T22:32:43Z","waiters":"","wisp_type":"","work_type":""}
